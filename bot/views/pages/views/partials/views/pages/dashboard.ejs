<!DOCTYPE html>
<html>
<%- include('../partials/head') %>
<body class="bg-gray-900 text-white p-6">
  <div class="max-w-5xl mx-auto">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-2xl font-bold">🤖 My Bots</h1>
      <a href="/logout" class="text-gray-400 hover:text-white">Logout</a>
    </div>
    <div class="grid gap-4">
      <% if (bots.length === 0) { %>
        <p class="text-gray-400">No bots yet. Run <code>/deploy</code> in Discord to create one!</p>
      <% } bots.forEach(bot => { %>
        <a href="/bot/<%= bot.id %>" class="bg-gray-800 p-4 rounded-lg hover:bg-gray-750">
          <div class="flex justify-between">
            <span class="font-semibold"><%= bot.name %></span>
            <span class="px-2 py-1 rounded text-sm <%= bot.status === 'running' ? 'bg-green-600' : 'bg-red-600' %>">
              <%= bot.status %>
            </span>
          </div>
          <p class="text-gray-400 text-sm mt-1 font-mono"><%= bot.id %></p>
        </a>
      <% }) %>
    </div>
  </div>
</body>
</html>
