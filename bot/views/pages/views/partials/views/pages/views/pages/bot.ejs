<!DOCTYPE html>
<html>
<%- include('../partials/head') %>
<body class="bg-gray-900 text-white p-6">
  <div class="max-w-5xl mx-auto">
    <a href="/dashboard" class="text-indigo-400 mb-4 inline-block">← Back</a>
    <h1 class="text-2xl font-bold mb-6"><%= bot.name %></h1>
    
    <div class="flex gap-3 mb-6">
      <form method="post" action="/bot/<%= bot.id %>/start">
        <button class="bg-green-600 hover:bg-green-700 px-4 py-2 rounded">▶ Start</button>
      </form>
      <form method="post" action="/bot/<%= bot.id %>/stop">
        <button class="bg-yellow-600 hover:bg-yellow-700 px-4 py-2 rounded">⏹ Stop</button>
      </form>
      <form method="post" action="/bot/<%= bot.id %>/restart">
        <button class="bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded">🔄 Restart</button>
      </form>
      <form method="post" action="/bot/<%= bot.id %>/delete" onsubmit="return confirm('Delete?')">
        <button class="bg-red-600 hover:bg-red-700 px-4 py-2 rounded">🗑 Delete</button>
      </form>
    </div>

    <div class="bg-gray-800 p-4 rounded-lg mb-4">
      <h3 class="font-semibold mb-2">Set Bot Token</h3>
      <form method="post" action="/bot/<%= bot.id %>/setenv">
        <input type="password" name="token" placeholder="Bot Token" class="w-full p-2 rounded bg-gray-700 mb-2" value="<%= bot.token ? '••••••••' : '' %>">
        <button class="bg-indigo-600 px-3 py-1 rounded">Save Token</button>
      </form>
    </div>

    <div class="bg-gray-800 p-4 rounded-lg">
      <h3 class="font-semibold mb-2">Edit main.js</h3>
      <form method="post" action="/bot/<%= bot.id %>/save">
        <input type="hidden" name="filename" value="main.js">
        <textarea name="content" class="w-full h-64 bg-gray-900 p-3 rounded font-mono text-sm"><%= require('fs').existsSync(require('path').join(__dirname, '../../containers', user.id, bot.id, 'main.js')) ? require('fs').readFileSync(require('path').join(__dirname, '../../containers', user.id, bot.id, 'main.js'), 'utf8') : '' %></textarea>
        <button class="bg-indigo-600 px-3 py-1 rounded mt-2">Save File</button>
      </form>
    </div>
  </div>
</body>
</html>
